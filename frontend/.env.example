# FoodSafe frontend — environment template. Copy to .env.local for local dev.
#   cp .env.example .env.local

# The deployed API's public URL (Render service URL in production, or your
# local uvicorn instance for dev). Read at build time by Next.js — no env.js
# workaround needed here (that was only for the old static index.html site).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Used by app/sitemap.ts to build absolute URLs. Set to your production
# domain once deployed.
NEXT_PUBLIC_SITE_URL=https://foodsafe.in
