# FoodSafe India — environment template. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored — never commit real credentials.

# ---- Database ----
# Local Postgres:
#   DATABASE_URL=postgresql://postgres@localhost:5432/foodsafe
#
# Supabase: use the IPv4 *Session pooler* connection string from the
# dashboard (Project → Connect → Session pooler). The direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from IPv4-only
# networks. sslmode=require is mandatory.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Auth ----
JWT_SECRET=change-me-in-production

# ---- Deployment ----
# BACKEND_LINK: the deployed API's public URL (Render service URL, e.g.
# https://foodsafe-api.onrender.com). Vercel's build step reads this and
# writes it into env.js so the static frontend (index.html) knows where to
# call — see vercel.json. Leave as localhost for local dev.
BACKEND_LINK=http://127.0.0.1:8000

# FRONTEND_URL: the deployed frontend's public URL (Vercel URL, e.g.
# https://foodsafe-india.vercel.app). Read by api/main.py to allow CORS
# requests from the deployed frontend, in addition to localhost.
FRONTEND_URL=https://foodsafe.in
