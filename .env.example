# FoodSafe India — environment template. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored — never commit real credentials.

# ---- Database ----
# Local Postgres:
#   DATABASE_URL=postgresql://postgres@localhost:5432/foodsafe
#
# Supabase: use the IPv4 *Session pooler* connection string from the
# dashboard (Project → Connect → Session pooler). The direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from IPv4-only
# networks. sslmode=require is mandatory.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Auth ----
JWT_SECRET=change-me-in-production

# ---- Deployment ----
# BACKEND_LINK: only used by the LEGACY single-file frontend (root index.html),
# whose Vercel config is now vercel.legacy-static.json and is not deployed by
# default. The current Next.js frontend reads NEXT_PUBLIC_API_URL instead, set
# in Vercel with Root Directory = frontend — see docs/DEPLOYMENT.md.
BACKEND_LINK=http://127.0.0.1:8000

# FRONTEND_URL: the deployed frontend's public URL (Vercel URL, e.g.
# https://foodsafe-india.vercel.app). Read by api/main.py to allow CORS
# requests from the deployed frontend, in addition to localhost.
FRONTEND_URL=https://foodsafe.in

# ---- Alert notifications (email only — see models/notifications.py) ----
# RESEND_API_KEY: from resend.com. If unset, models/notifications.py logs
# what it would have sent and skips delivery — a legitimate "not configured"
# state, not an error. Also set as a GitHub Actions secret for the nightly
# ingest.yml notification step.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alerts@foodsafe.in
